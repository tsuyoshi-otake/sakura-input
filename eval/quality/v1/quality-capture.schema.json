{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sakura-input/eval/quality/v1/quality-capture.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/whole_reading_core_capture" },
    { "$ref": "#/$defs/active_segment_replay_capture" }
  ],
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminal": { "type": "string", "minLength": 1 },
        "truncated": { "type": "boolean" },
        "elapsed_us": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": ["terminal", "truncated", "elapsed_us"]
    },
    "core_artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "evaluator_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "dictionary_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "required": ["git_sha", "evaluator_sha256", "dictionary_sha256"]
    },
    "active_artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "engine_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "dictionary_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "required": ["git_sha", "engine_sha256", "dictionary_sha256"]
    },
    "core_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "segments": {
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        },
        "origin": { "type": ["string", "null"] },
        "cost": { "type": ["integer", "null"] }
      },
      "required": ["surface", "segments", "origin", "cost"]
    },
    "core_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "items": { "$ref": "#/$defs/core_candidate" }
        }
      },
      "required": ["candidates"]
    },
    "core_pair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "baseline": { "$ref": "#/$defs/core_output" },
        "candidate": { "$ref": "#/$defs/core_output" }
      },
      "required": ["case_id", "baseline", "candidate"]
    },
    "core_control_pair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_id": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 },
        "baseline": { "$ref": "#/$defs/core_output" },
        "candidate": { "$ref": "#/$defs/core_output" }
      },
      "required": ["control_id", "reading", "baseline", "candidate"]
    },
    "active_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["candidates"]
    },
    "active_pair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "baseline": { "$ref": "#/$defs/active_output" },
        "candidate": { "$ref": "#/$defs/active_output" }
      },
      "required": ["case_id", "baseline", "candidate"]
    },
    "active_control_pair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_id": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 },
        "baseline": { "$ref": "#/$defs/active_output" },
        "candidate": { "$ref": "#/$defs/active_output" }
      },
      "required": ["control_id", "reading", "baseline", "candidate"]
    },
    "whole_reading_core_capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 2 },
        "lane": { "const": "whole_reading_core" },
        "baseline": { "$ref": "#/$defs/core_artifact" },
        "candidate": { "$ref": "#/$defs/core_artifact" },
        "pairs": {
          "type": "array",
          "minItems": 50,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/core_pair" }
        },
        "control_pairs": {
          "type": "array",
          "items": { "$ref": "#/$defs/core_control_pair" }
        },
        "baseline_capture": { "$ref": "#/$defs/runtime" },
        "candidate_capture": { "$ref": "#/$defs/runtime" }
      },
      "required": ["schema_version", "lane", "baseline", "candidate", "pairs", "control_pairs", "baseline_capture", "candidate_capture"]
    },
    "active_segment_replay_capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 2 },
        "lane": { "const": "active_segment_replay" },
        "baseline": { "$ref": "#/$defs/active_artifact" },
        "candidate": { "$ref": "#/$defs/active_artifact" },
        "pairs": {
          "type": "array",
          "minItems": 50,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/active_pair" }
        },
        "control_pairs": {
          "type": "array",
          "items": { "$ref": "#/$defs/active_control_pair" }
        },
        "baseline_capture": { "$ref": "#/$defs/runtime" },
        "candidate_capture": { "$ref": "#/$defs/runtime" }
      },
      "required": ["schema_version", "lane", "baseline", "candidate", "pairs", "control_pairs", "baseline_capture", "candidate_capture"]
    }
  }
}
