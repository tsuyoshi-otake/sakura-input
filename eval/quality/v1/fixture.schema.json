{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sakura-input/eval/quality/v1/fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_id": { "type": "string", "minLength": 1 },
    "stage": { "const": "stage1" },
    "candidate_limit": { "const": 18 },
    "options": { "$ref": "#/$defs/options" },
    "cases": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/case" }
    },
    "negative_controls": {
      "type": "array",
      "items": { "$ref": "#/$defs/negative_control" }
    }
  },
  "required": ["schema_version", "corpus_id", "stage", "candidate_limit", "options", "cases", "negative_controls"],
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "const": "quality-stage1-default" },
        "candidate_limit": { "const": 18 },
        "options_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "config_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "learning": { "const": "disabled" },
        "user_dictionary": { "const": "disabled" },
        "reranker": { "const": "off" }
      },
      "required": ["profile", "candidate_limit", "options_sha256", "config_sha256", "learning", "user_dictionary", "reranker"]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "pattern": "^cq-[0-9]{3}$" },
        "category": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 },
        "before_surface": { "type": "string", "minLength": 1 },
        "before_segments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "expected_surface": { "type": "string", "minLength": 1 },
        "expected_segments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "segment_assertion": { "enum": ["explicit", "surface_only"] },
        "assertion_scope": { "enum": ["candidate_observation", "context_required", "hold"] },
        "notes": { "type": "string" }
      },
      "required": ["case_id", "category", "reading", "before_surface", "before_segments", "expected_surface", "expected_segments", "segment_assertion", "assertion_scope"]
    },
    "negative_control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_id": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "policy": { "enum": ["report_if_top1", "retain_as_competitor", "preserve_literal"] },
        "note": { "type": "string" }
      },
      "required": ["control_id", "reading", "surface", "policy"]
    }
  }
}
