{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sakura-input/eval/quality/v1/quality-observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_id": { "type": "string", "minLength": 1 },
    "capture_lane": { "const": "whole_reading_core" },
    "candidate_limit": { "const": 18 },
    "options": { "$ref": "#/$defs/options" },
    "baseline": { "$ref": "#/$defs/system_score" },
    "candidate": { "$ref": "#/$defs/system_score" },
    "score_elapsed_us": { "type": "integer", "minimum": 0 },
    "determinism_fingerprint": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  },
  "required": ["schema_version", "corpus_id", "capture_lane", "candidate_limit", "options", "baseline", "candidate", "score_elapsed_us", "determinism_fingerprint"],
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "const": "quality-stage1-default" },
        "candidate_limit": { "const": 18 },
        "options_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "config_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "learning": { "type": "string" },
        "user_dictionary": { "type": "string" },
        "reranker": { "type": "string" }
      },
      "required": ["profile", "candidate_limit", "options_sha256", "config_sha256", "learning", "user_dictionary", "reranker"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "evaluator_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "dictionary_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "required": ["git_sha", "evaluator_sha256", "dictionary_sha256"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata_status": { "const": "core_whole_reading" },
        "terminal": { "type": "string", "minLength": 1 },
        "truncated": { "type": ["boolean", "null"] },
        "elapsed_us": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": ["metadata_status", "terminal", "truncated", "elapsed_us"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "segments": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
        "origin": { "type": ["string", "null"] },
        "cost": { "type": ["integer", "null"] }
      },
      "required": ["surface", "segments", "origin", "cost"]
    },
    "negative_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_id": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "top1": { "type": "boolean" },
        "in_top18": { "type": "boolean" },
        "policy": { "enum": ["report_if_top1", "retain_as_competitor", "preserve_literal"] }
      },
      "required": ["control_id", "surface", "top1", "in_top18", "policy"]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 },
        "expected_surface": { "type": "string", "minLength": 1 },
        "expected_segments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "segment_assertion": { "enum": ["explicit", "surface_only"] },
        "assertion_scope": { "enum": ["candidate_observation", "context_required", "hold"] },
        "candidate_limit": { "const": 18 },
        "candidate_surfaces": { "type": "array", "minItems": 1, "maxItems": 18, "items": { "type": "string", "minLength": 1 } },
        "candidates": { "type": "array", "minItems": 1, "maxItems": 18, "items": { "$ref": "#/$defs/candidate" } },
        "surface_top1": { "type": "boolean" },
        "surface_rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 18 },
        "surface_in_top18": { "type": "boolean" },
        "segment_status": { "type": "string", "minLength": 1 },
        "segment_exact": { "type": ["boolean", "null"] },
        "candidate_metadata_status": { "enum": ["core_origin_and_cost_observed", "core_origin_or_cost_unsupported"] },
        "competitors": { "type": "array", "items": { "$ref": "#/$defs/negative_observation" } },
        "elapsed_us": { "type": ["integer", "null"], "minimum": 0 },
        "terminal": { "type": ["string", "null"] },
        "truncated": { "type": ["boolean", "null"] }
      },
      "required": ["case_id", "category", "reading", "expected_surface", "expected_segments", "segment_assertion", "assertion_scope", "candidate_limit", "candidate_surfaces", "candidates", "surface_top1", "surface_rank", "surface_in_top18", "segment_status", "segment_exact", "candidate_metadata_status", "competitors", "elapsed_us", "terminal", "truncated"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "surface_top1": { "type": "integer", "minimum": 0 },
        "surface_in_top18": { "type": "integer", "minimum": 0 },
        "mrr_at18": { "type": "number", "minimum": 0, "maximum": 1 },
        "segment_observed": { "type": "integer", "minimum": 0 },
        "segment_exact": { "type": "integer", "minimum": 0 },
        "negative_control_top1": { "type": "integer", "minimum": 0 },
        "negative_control_in_top18": { "type": "integer", "minimum": 0 }
      },
      "required": ["total", "surface_top1", "surface_in_top18", "mrr_at18", "segment_observed", "segment_exact", "negative_control_top1", "negative_control_in_top18"]
    },
    "system_score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact" },
        "capture": { "$ref": "#/$defs/runtime" },
        "summary": { "$ref": "#/$defs/summary" },
        "observations": { "type": "array", "minItems": 50, "maxItems": 50, "items": { "$ref": "#/$defs/observation" } },
        "negative_controls": { "type": "array", "items": { "$ref": "#/$defs/negative_observation" } }
      },
      "required": ["artifact", "capture", "summary", "observations", "negative_controls"]
    }
  }
}
