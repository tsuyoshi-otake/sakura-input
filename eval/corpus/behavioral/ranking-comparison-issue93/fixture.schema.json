{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sakura-input/eval/corpus/behavioral/ranking-comparison-issue93/fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_id": { "const": "issue93-ranking-comparison-v1" },
    "stage": { "const": "phase0" },
    "candidate_limit": { "const": 18 },
    "options": { "$ref": "#/$defs/options" },
    "reference_comparison": { "$ref": "#/$defs/reference_comparison" },
    "cases": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "stage",
    "candidate_limit",
    "options",
    "reference_comparison",
    "cases"
  ],
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "const": "issue93-ranking-comparison-v1" },
        "candidate_limit": { "const": 18 },
        "recall_k": { "const": 5 },
        "learning": { "const": "disabled" },
        "user_dictionary": { "const": "disabled" },
        "reranker": { "const": "off" },
        "input_repair": { "const": "disabled" },
        "context": { "const": "empty" },
        "locale": { "const": "ja-JP" }
      },
      "required": [
        "profile",
        "candidate_limit",
        "recall_k",
        "learning",
        "user_dictionary",
        "reranker",
        "input_repair",
        "context",
        "locale"
      ]
    },
    "reference_comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_label": { "const": "v1.0.5" },
        "after_label": { "const": "v1.0.23" },
        "ablation_label": { "const": "v1.0.23-it-compound-bonus-off" },
        "source": { "const": "issue93-confirmed-cross-version-comparison" }
      },
      "required": ["baseline_label", "after_label", "ablation_label", "source"]
    },
    "reference_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": { "type": "string", "minLength": 1 },
        "after": { "type": "string", "minLength": 1 },
        "ablation": { "type": "string", "minLength": 1 }
      },
      "required": ["baseline", "after", "ablation"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "issue93_confirmed_observation",
            "dictionary_contract",
            "coverage_sentinel"
          ]
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "summary": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "references", "summary"]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "pattern": "^rc93-[gic]-[0-9]{3}$" },
        "role": {
          "enum": [
            "general_negative_control",
            "it_positive",
            "coverage_sentinel"
          ]
        },
        "contrast_group": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 },
        "assertion_kind": { "enum": ["top1", "recall_at_k"] },
        "assertion_k": { "type": "integer", "minimum": 1, "maximum": 18 },
        "expected_surface": { "type": "string", "minLength": 1 },
        "semantic_scope": {
          "enum": ["bounded_issue93_regression", "candidate_presence_only"]
        },
        "ambiguity": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "reference_observation": { "$ref": "#/$defs/reference_observation" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "required": [
        "case_id",
        "role",
        "contrast_group",
        "category",
        "reading",
        "assertion_kind",
        "assertion_k",
        "expected_surface",
        "semantic_scope",
        "ambiguity",
        "rationale",
        "provenance"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "assertion_kind": { "const": "top1" } },
            "required": ["assertion_kind"]
          },
          "then": {
            "properties": {
              "assertion_k": { "const": 1 },
              "semantic_scope": { "const": "bounded_issue93_regression" }
            }
          }
        },
        {
          "if": {
            "properties": { "assertion_kind": { "const": "recall_at_k" } },
            "required": ["assertion_kind"]
          },
          "then": {
            "properties": {
              "assertion_k": { "const": 5 },
              "semantic_scope": { "const": "candidate_presence_only" }
            }
          }
        }
      ]
    }
  }
}
