  {
    "term": "ミュータブル",
    "aliases": [
      "Mutable",
      "可変",
      "可変オブジェクト"
    ],
    "senses": [
      {
        "definition": "作成後に内容を変更できるオブジェクトや値のこと。多くのデフォルトオブジェクトはミュータブルだが、共有された状態を複数箇所から変更するとバグの原因になりやすい。イミュータブルと対比して、変更可能性（mutability）の設計判断はコードの安全性に影響する。",
        "domain": "engineering",
        "keywords": [
          "可変",
          "状態変更",
          "副作用",
          "共有状態",
          "イミュータブルとの対比"
        ]
      }
    ]
  },
  {
