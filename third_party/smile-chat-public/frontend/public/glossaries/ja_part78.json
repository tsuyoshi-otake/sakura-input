[
  {
    "term": "文書保管",
    "reading": "ぶんしょほかん",
    "aliases": [
      "Document Storage",
      "Document Archiving",
      "Document Retention"
    ],
    "senses": [
      {
        "definition": "文書を保存・管理すること。法定保存期間・社内規程に基づき、電子ファイルまたは紙で文書を保存・管理する業務。検索性・アクセス管理・廃棄ルールも含む文書ライフサイクル管理の核心。",
        "domain": "operations",
        "keywords": [
          "保存",
          "アーカイブ",
          "保存期間",
          "廃棄",
          "アクセス管理"
        ]
      }
    ]
  },
  {
    "term": "文書登録",
    "reading": "ぶんしょとうろく",
    "aliases": [
      "Document Registration",
      "Document Filing"
    ],
    "senses": [
      {
        "definition": "文書を所定の保管先や管理システムへ登録すること。押印済み契約書・申請書・承認書などを文書管理システムへ登録し、検索・参照できる状態にする。文書番号・分類・保存期限も合わせて設定する。",
        "domain": "operations",
        "keywords": [
          "登録",
          "文書管理",
          "分類",
          "文書番号",
          "保存期限"
        ]
      }
    ]
  },
  {
    "term": "登録期限",
    "reading": "とうろくきげん",
    "aliases": [
      "Registration Deadline",
      "Filing Deadline"
    ],
    "senses": [
      {
        "definition": "対象となる情報や文書を登録すべき期限。契約書・申請書・伝票などの登録期限を守ることで、業務の遅延や法的リスクを回避する。期限超過は督促・エスカレーション対象となる。",
        "domain": "operations",
        "keywords": [
          "期限",
          "締め切り",
          "督促",
          "エスカレーション",
          "管理"
        ]
      }
    ]
  },
  {
    "term": "ステータス",
    "reading": "すてーたす",
    "aliases": [
      "Status"
    ],
    "senses": [
      {
        "definition": "対象の進捗や状態を表す管理項目。契約管理では「入力中」「条件提示」「条件合意」「案文合意」「決裁済」「締結済」などのステータスで各契約の進行状況を可視化する。ステータス管理により担当者全員が現状を共有できる。",
        "domain": "operations",
        "keywords": [
          "進捗",
          "状態",
          "可視化",
          "管理",
          "フロー"
        ]
      }
    ]
  },
  {
    "term": "入力中",
    "reading": "にゅうりょくちゅう",
    "aliases": [
      "In Progress",
      "Editing",
      "Draft"
    ],
    "senses": [
      {
        "definition": "作成や編集の途中にある状態を示すステータス。契約書や申請書の入力が始まっているが、まだ提出・承認依頼には至っていない段階。担当者が内容を確認・修正している最中。",
        "domain": "operations",
        "keywords": [
          "ステータス",
          "作成中",
          "編集",
          "下書き",
          "進捗"
        ]
      }
    ]
  },
  {
    "term": "条件提示",
    "reading": "じょうけんていじ",
    "aliases": [
      "Terms Presented",
      "Offer Made"
    ],
    "senses": [
      {
        "definition": "条件を相手へ示した状態を示すステータス。自社が価格・条件などを相手先に提示し、相手からの回答を待っている段階。相手先の反応次第で条件合意または再交渉に進む。",
        "domain": "operations",
        "keywords": [
          "ステータス",
          "提示済み",
          "待機",
          "回答待ち",
          "交渉"
        ]
      }
    ]
  },
  {
    "term": "確定",
    "reading": "かくてい",
    "aliases": [
      "Confirmed",
      "Finalized",
      "Fixed"
    ],
    "senses": [
      {
        "definition": "内容が固まった状態。交渉・確認・調整のプロセスを経て変更不要と判断された段階。確定後は押印申請・出力・送付などの次工程に進む。",
        "domain": "operations",
        "keywords": [
          "ステータス",
          "確定済み",
          "変更不可",
          "合意",
          "次工程"
        ]
      }
    ]
  },
  {
    "term": "決裁済",
    "reading": "けっさいずみ",
    "aliases": [
      "Approved",
      "Authorized",
      "Sanctioned"
    ],
    "senses": [
      {
        "definition": "承認が完了した状態を示すステータス。決裁権者による最終承認が得られ、次の業務ステップ（押印・送付・締結など）に進める状態。承認日時・承認者が記録される。",
        "domain": "operations",
        "keywords": [
          "ステータス",
          "承認完了",
          "決裁",
          "承認者",
          "次工程"
        ]
      }
    ]
  },
  {
    "term": "締結済",
    "reading": "ていけつずみ",
    "aliases": [
      "Concluded",
      "Executed",
      "Signed"
    ],
    "senses": [
      {
        "definition": "合意と必要な手続き（押印・署名・交換など）が完了し、契約が正式に成立した状態を示すステータス。締結日・相手先・担当者が記録され、以後は契約の履行管理フェーズに移行する。",
        "domain": "operations",
        "keywords": [
          "ステータス",
          "締結",
          "契約成立",
          "押印完了",
          "履行管理"
        ]
      }
    ]
  },
