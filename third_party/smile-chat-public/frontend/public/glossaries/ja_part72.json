[
  {
    "term": "マイクロアーキテクチャ",
    "reading": "まいくろあーきてくちゃ",
    "aliases": [
      "Microarchitecture",
      "μarch"
    ],
    "senses": [
      {
        "definition": "CPUが命令セットアーキテクチャ（ISA）を実際にどのように実装しているかを表す内部設計。パイプライン段数・実行幅・分岐予測・キャッシュ構成・Out-of-Order実行の有無などが含まれ、同じISA対応でもメーカーや世代により大きく異なる。性能・消費電力・発熱に直結する。",
        "domain": "computer-architecture",
        "keywords": [
          "CPU",
          "内部設計",
          "ISA",
          "パイプライン",
          "実装"
        ]
      }
    ]
  },
  {
    "term": "命令セットアーキテクチャ",
    "reading": "めいれいせっとあーきてくちゃ",
    "aliases": [
      "ISA",
      "Instruction Set Architecture"
    ],
    "senses": [
      {
        "definition": "ソフトウェアから見えるCPUの仕様を定義した抽象層。命令の種類・レジスタ構成・アドレッシングモード・例外処理・メモリモデルなどのルールを規定する。プログラム互換性はISAで決まり、性能特性はマイクロアーキテクチャで変わる。",
        "domain": "computer-architecture",
        "keywords": [
          "命令セット",
          "仕様",
          "互換性",
          "レジスタ",
          "アドレッシング"
        ]
      }
    ]
  },
  {
    "term": "命令セット",
    "reading": "めいれいせっと",
    "aliases": [
      "Instruction Set",
      "命令体系"
    ],
    "senses": [
      {
        "definition": "CPUが実行できる機械語命令の集合。算術演算・論理演算・データ転送・分岐・制御命令などで構成される。CISC（複雑命令セット）とRISC（縮小命令セット）の設計哲学があり、x86-64はCISC系、ARMはRISC系に分類される。",
        "domain": "computer-architecture",
        "keywords": [
          "機械語",
          "CISC",
          "RISC",
          "命令",
          "CPU"
        ]
      }
    ]
  },
  {
    "term": "分岐予測",
    "reading": "ぶんきよそく",
    "aliases": [
      "Branch Prediction",
      "ブランチプレディクション"
    ],
    "senses": [
      {
        "definition": "条件分岐命令の結果を事前に予測してパイプラインの停止を回避する技術。静的予測（常に分岐する/しないと仮定）と動的予測（過去の履歴に基づく予測）があり、現代CPUでは95%以上の精度を達成する。予測ミスはパイプラインフラッシュを引き起こす。",
        "domain": "computer-architecture",
        "keywords": [
          "分岐",
          "予測",
          "パイプライン",
          "フラッシュ",
          "性能"
        ]
      }
    ]
  },
  {
    "term": "Out-of-Order実行",
    "reading": "あうとおぶおーだーじっこう",
    "aliases": [
      "OoO実行",
      "アウトオブオーダー実行",
      "Out-of-Order Execution"
    ],
    "senses": [
      {
        "definition": "プログラム順序に関わらず、データ依存関係のない命令を先に実行する技術。リオーダバッファで元の順序を管理しつつ、実行ユニットの空きを最大限活用して性能を向上させる。高性能CPUの中核技術の一つ。",
        "domain": "computer-architecture",
        "keywords": [
          "順序外実行",
          "リオーダバッファ",
          "依存関係",
          "並列性",
          "高性能"
        ]
      }
    ]
  },
  {
    "term": "レジスタリネーミング",
    "reading": "れじすたりねーみんぐ",
    "aliases": [
      "Register Renaming",
      "レジスタ改名"
    ],
    "senses": [
      {
        "definition": "命令間の見かけ上のレジスタ依存（WAR・WAW依存）を解消するため、論理レジスタを物理レジスタに動的に割り当てる技術。Out-of-Order実行と組み合わせて使用され、命令レベル並列性を高める。",
        "domain": "computer-architecture",
        "keywords": [
          "レジスタ",
          "依存関係",
          "並列性",
          "WAR",
          "WAW"
        ]
      }
    ]
  },
  {
    "term": "命令フェッチ",
    "reading": "めいれいふぇっち",
    "aliases": [
      "Instruction Fetch"
    ],
    "senses": [
      {
        "definition": "メモリやキャッシュからCPUが実行すべき命令を取り出すパイプラインの最初の段階。命令キャッシュ（L1I）からの読み出し速度がスループットに直結し、分岐予測と連携して次に実行する命令のアドレスを決定する。",
        "domain": "computer-architecture",
        "keywords": [
          "フェッチ",
          "パイプライン",
          "命令キャッシュ",
          "L1I",
          "スループット"
        ]
      }
    ]
  },
  {
    "term": "命令デコード",
    "reading": "めいれいでこーど",
    "aliases": [
      "Instruction Decode",
      "ID",
      "デコード"
    ],
    "senses": [
      {
        "definition": "フェッチした命令を内部で処理可能な形式（マイクロオペレーション等）に分解するパイプライン段階。CISCアーキテクチャでは可変長命令を固定長の内部命令に変換する必要があり、デコーダの複雑さがボトルネックになりうる。",
        "domain": "computer-architecture",
        "keywords": [
          "デコード",
          "マイクロオペレーション",
          "パイプライン",
          "CISC",
          "変換"
        ]
      }
    ]
  },
