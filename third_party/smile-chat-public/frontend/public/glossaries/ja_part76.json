    "senses": [
      {
        "definition": "契約書に記載する文面や条項の案。正式な契約書として製本・押印する前に双方で内容を確認・修正するための原稿。交渉や確認・調整のプロセスで使われ、案文合意が得られた後に本紙として作成する。",
        "domain": "operations",
        "keywords": [
          "文面",
          "条項",
          "草案",
          "原稿",
          "確認"
        ]
      }
    ]
  },
