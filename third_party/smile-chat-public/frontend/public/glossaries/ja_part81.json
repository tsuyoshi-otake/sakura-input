[
  {
    "term": "売上原価",
    "reading": "うりあげげんか",
    "aliases": [
      "Cost of Goods Sold",
      "Cost of Sales"
    ],
    "senses": [
      {
        "definition": "売上高に対応する商品・製品を販売するために要したコスト。商品仕入れ・製造にかかる材料費・労務費・製造経費などから構成される。損益計算書において売上高から差し引いて売上総利益（粗利益）を算出する。",
        "domain": "finance",
        "keywords": [
          "売上総利益",
          "粗利益",
          "製造原価",
          "仕入原価",
          "損益計算書"
        ]
      }
    ]
  },
  {
