    ],
    "senses": [
      {
        "definition": "データベースのテーブルに付ける名前。格納するエンティティを複数形の名詞で表すことが多い（例：users、orders）。テーブル名はSQLや各種ORMを通じてアプリケーション全体に影響するため、変更コストが高く最初の命名が重要。",
        "domain": "engineering",
        "keywords": [
          "データベース",
          "テーブル",
          "スキーマ",
          "命名",
          "エンティティ"
        ]
      }
    ]
  },
  {
