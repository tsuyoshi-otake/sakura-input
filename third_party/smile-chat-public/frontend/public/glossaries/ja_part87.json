[
  {
    "term": "変数名",
    "aliases": [
      "Variable Name"
    ],
    "senses": [
      {
        "definition": "プログラム中で変数を識別するための名前。意味が伝わる具体的な名前をつけることが保守性向上の基本。スコープや型の特性を反映した命名が推奨され、xやtmpのような汎用的すぎる名前は避けるべきとされる。",
        "domain": "engineering",
        "keywords": [
          "変数",
          "識別子",
          "スコープ",
          "命名",
          "可読性"
        ]
      }
    ]
  },
  {
    "term": "関数名",
    "aliases": [
      "Function Name"
    ],
    "senses": [
      {
        "definition": "関数・メソッドに付ける識別子。「何をする関数か」が一目でわかるよう動詞を先頭に置くことが多い（例：getUserById、sendEmail）。命名から責務の範囲が明確になることが良い設計の指標となる。",
        "domain": "engineering",
        "keywords": [
          "関数",
          "命名",
          "動詞",
          "責務",
          "識別子"
        ]
      }
    ]
  },
  {
    "term": "クラス名",
    "aliases": [
      "Class Name"
    ],
    "senses": [
      {
        "definition": "クラスに付ける識別子。一般的に名詞・PascalCaseで表記し、そのクラスが表すエンティティや概念を表す（例：UserRepository、OrderService）。名前がクラスの責務を過不足なく表していることが重要。",
        "domain": "engineering",
        "keywords": [
          "クラス",
          "PascalCase",
          "エンティティ",
          "命名",
          "責務"
        ]
      }
    ]
  },
  {
