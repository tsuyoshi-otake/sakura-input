  {"term":"PUT","aliases":[],"senses":[{"definition":"既存のリソース全体を置き換えて更新するHTTPメソッドです。","domain":"web-api","keywords":["HTTP","更新","REST"]}]},
  {"term":"row","reading":"ろう","aliases":["行"],"senses":[{"definition":"データベーステーブルにおける1件分のデータの横方向のまとまりです。","domain":"database","keywords":["テーブル","レコード","カラム"]}]},
