[
  {"term":"else","aliases":[],"senses":[{"definition":"ifの条件に当てはまらなかったときに実行される処理です。","domain":"programming","keywords":["if","条件分岐","制御構文"]}]},
  {"term":"else if","aliases":["elif"],"senses":[{"definition":"最初のif条件が偽のとき、別の条件を続けて確認する構文です。","domain":"programming","keywords":["if","条件分岐","制御構文"]}]},
  {"term":"switch","aliases":[],"senses":[{"definition":"値によって処理を分けるときに使う制御構文です。複数のcaseを持ちます。","domain":"programming","keywords":["case","条件分岐","制御構文"]}]},
  {"term":"default","aliases":[],"senses":[{"definition":"switchでどのcaseにも当てはまらないときの処理です。また、初期設定の意味でも使われます。","domain":"programming","keywords":["switch","case","初期値"]}]},
  {"term":"do while","aliases":["do...while"],"senses":[{"definition":"まず1回処理を実行してから条件を確認し、条件が真の間繰り返すループ構文です。","domain":"programming","keywords":["ループ","繰り返し","制御構文"]}]},
  {"term":"break","aliases":[],"senses":[{"definition":"繰り返し処理やswitch文を途中で抜け出すための文です。","domain":"programming","keywords":["ループ","中断","制御構文"]}]},
  {"term":"continue","aliases":[],"senses":[{"definition":"現在の繰り返しの残り処理をスキップし、次の繰り返しへ進む文です。","domain":"programming","keywords":["ループ","スキップ","制御構文"]}]},
  {"term":"try","aliases":[],"senses":[{"definition":"エラーが起きるかもしれない処理を囲み、例外を安全に扱うための構文です。","domain":"programming","keywords":["例外処理","catch","エラー"]}]},
  {"term":"catch","aliases":[],"senses":[{"definition":"tryブロックで発生した例外を受け取って処理する構文です。","domain":"programming","keywords":["例外処理","try","エラー"]}]},
  {"term":"finally","aliases":[],"senses":[{"definition":"try-catchの後にエラーの有無に関係なく必ず実行される処理ブロックです。","domain":"programming","keywords":["例外処理","try","クリーンアップ"]}]},
  {"term":"throw","aliases":[],"senses":[{"definition":"意図的に例外を発生させる文です。エラー状態を呼び出し元に伝えるために使います。","domain":"programming","keywords":["例外","エラー","制御構文"]}]},
  {"term":"statement","reading":"すてーとめんと","aliases":["文"],"senses":[{"definition":"プログラムにおける1つの命令や動作の単位です。代入文、条件文、ループ文などがあります。","domain":"programming","keywords":["命令","文","式"]}]},
  {"term":"expression","reading":"えくすぷれっしょん","aliases":["式"],"senses":[{"definition":"評価されて値を生み出すコードの断片です。1+2やa>bなどが式にあたります。","domain":"programming","keywords":["値","評価","演算"]}]},
  {"term":"block","reading":"ぶろっく","aliases":["ブロック"],"senses":[{"definition":"波括弧{}などで囲まれた複数の文のまとまりです。if文やfor文の本体として使われます。","domain":"programming","keywords":["スコープ","波括弧","構造"]}]},
  {"term":"constant","reading":"こんすたんと","aliases":["const"],"senses":[{"definition":"一度代入したら変更できない値です。JavaScriptではconst、Javaではfinalなどで宣言します。","domain":"programming","keywords":["変数","不変","宣言"]}]},
  {"term":"initialization","reading":"いにしゃらいぜーしょん","aliases":["初期化"],"senses":[{"definition":"変数やオブジェクトに最初の値を設定することです。宣言と同時に行うことが多いです。","domain":"programming","keywords":["変数","宣言","初期値"]}]},
  {"term":"assignment","reading":"あさいんめんと","aliases":["代入"],"senses":[{"definition":"変数に値を格納する操作です。多くの言語で=記号を使います。","domain":"programming","keywords":["変数","値","イコール"]}]},
  {"term":"string","reading":"すとりんぐ","aliases":[],"senses":[{"definition":"文字の並びを表すデータ型です。ダブルクォートやシングルクォートで囲んで記述します。","domain":"programming","keywords":["データ型","文字","テキスト"]}]},
  {"term":"character","reading":"きゃらくたー","aliases":["文字","char"],"senses":[{"definition":"1文字分のデータを表す型です。Javaのchar型などが代表例です。","domain":"programming","keywords":["データ型","文字列","1文字"]}]},
  {"term":"number","reading":"なんばー","aliases":[],"senses":[{"definition":"数を表すデータ型の総称です。整数と浮動小数点数を含みます。","domain":"programming","keywords":["データ型","整数","小数"]}]},
  {"term":"integer","reading":"いんてじゃー","aliases":["整数","int"],"senses":[{"definition":"小数部分を持たない数値型です。Javaではint、Pythonではintで扱います。","domain":"programming","keywords":["データ型","数値","小数なし"]}]},
  {"term":"float","reading":"ふろーと","aliases":["浮動小数点数"],"senses":[{"definition":"小数を含む数値を扱うデータ型です。精度に限りがあるため、金額計算には注意が必要です。","domain":"programming","keywords":["データ型","小数","精度"]}]},
  {"term":"double","reading":"だぶる","aliases":[],"senses":[{"definition":"floatより高い精度で小数を扱える数値型です。64ビットの浮動小数点数を表します。","domain":"programming","keywords":["データ型","小数","高精度"]}]},
  {"term":"true","reading":"とぅるー","aliases":["真"],"senses":[{"definition":"真偽値（boolean）における「真」を表す値です。条件式が成立するときに返されます。","domain":"programming","keywords":["boolean","条件","偽"]}]},
  {"term":"false","reading":"ふぉるす","aliases":["偽"],"senses":[{"definition":"真偽値（boolean）における「偽」を表す値です。条件式が成立しないときに返されます。","domain":"programming","keywords":["boolean","条件","真"]}]},
  {"term":"null","reading":"ぬる","aliases":["ナル"],"senses":[{"definition":"値が存在しないことを明示的に表す特別な値です。undefinedとは異なり、意図的に「空」を設定した状態です。","domain":"programming","keywords":["値なし","undefined","空"]}]},
  {"term":"undefined","reading":"あんでぃふぁいんど","aliases":[],"senses":[{"definition":"変数が宣言されたが値が設定されていない状態を表します。JavaScriptに特有の概念です。","domain":"javascript","keywords":["null","未定義","値なし"]}]},
  {"term":"array","reading":"あれい","aliases":[],"senses":[{"definition":"複数の値を順番に並べて格納するデータ構造です。インデックス（番号）で各要素にアクセスします。","domain":"programming","keywords":["データ構造","インデックス","要素"]}]},
  {"term":"value","reading":"ばりゅー","aliases":[],"senses":[{"definition":"変数や式が保持・返却する具体的なデータそのものです。数値、文字列、オブジェクトなどがあります。","domain":"programming","keywords":["データ","変数","型"]}]},
  {"term":"literal","reading":"りてらる","aliases":["リテラル"],"senses":[{"definition":"ソースコード中に直接記述された値です。42、\"hello\"、trueなどがリテラルにあたります。","domain":"programming","keywords":["値","定数","コード"]}]},
  {"term":"==","aliases":["等価演算子"],"senses":[{"definition":"左右の値が等しいかを比較する演算子です。JavaScriptでは型変換を行ってから比較します。","domain":"programming","keywords":["比較","等しい","演算子"]}]},
  {"term":"===","aliases":["厳密等価演算子"],"senses":[{"definition":"値と型の両方が一致するかを厳密に比較する演算子です。JavaScriptで推奨される比較方法です。","domain":"javascript","keywords":["比較","型","厳密"]}]},
  {"term":"!=","aliases":["不等価演算子"],"senses":[{"definition":"左右の値が等しくないかを比較する演算子です。","domain":"programming","keywords":["比較","等しくない","演算子"]}]},
  {"term":"!==","aliases":["厳密不等価演算子"],"senses":[{"definition":"値または型が異なるかを厳密に比較する演算子です。","domain":"javascript","keywords":["比較","型","厳密"]}]},
  {"term":"++","aliases":["インクリメント"],"senses":[{"definition":"変数の値を1だけ増やす演算子です。i++やi+=1と同等です。","domain":"programming","keywords":["加算","ループ","演算子"]}]},
  {"term":"--","aliases":["デクリメント"],"senses":[{"definition":"変数の値を1だけ減らす演算子です。","domain":"programming","keywords":["減算","ループ","演算子"]}]},
  {"term":"&&","aliases":["論理AND"],"senses":[{"definition":"両方の条件が真のときに真を返す論理演算子です。","domain":"programming","keywords":["論理演算","条件","AND"]}]},
  {"term":"||","aliases":["論理OR"],"senses":[{"definition":"どちらか一方の条件が真であれば真を返す論理演算子です。","domain":"programming","keywords":["論理演算","条件","OR"]}]},
  {"term":"!","aliases":["論理NOT"],"senses":[{"definition":"真偽値を反転させる論理演算子です。trueをfalseに、falseをtrueにします。","domain":"programming","keywords":["論理演算","反転","否定"]}]},
  {"term":"?:","aliases":["三項演算子","ternary operator"],"senses":[{"definition":"条件 ? 真の値 : 偽の値の形式で、条件により2つの値を使い分ける演算子です。","domain":"programming","keywords":["条件","省略記法","演算子"]}]},
  {"term":"??","aliases":["ヌル合体演算子","nullish coalescing"],"senses":[{"definition":"左辺がnullまたはundefinedのとき右辺の値を返す演算子です。デフォルト値の設定に便利です。","domain":"javascript","keywords":["null","デフォルト値","演算子"]}]},
  {"term":"+=","aliases":["加算代入"],"senses":[{"definition":"現在の値に右辺を加算してそのまま代入する複合代入演算子です。a+=bはa=a+bと同等です。","domain":"programming","keywords":["代入","演算子","省略記法"]}]},
  {"term":"return value","reading":"りたーんばりゅー","aliases":[],"senses":[{"definition":"関数が処理を終えて呼び出し元に返す値です。return文で指定します。","domain":"programming","keywords":["関数","return","結果"]}]},
  {"term":"callback","reading":"こーるばっく","aliases":["コールバック関数"],"senses":[{"definition":"別の関数に引数として渡され、特定のタイミングで呼び出される関数です。非同期処理やイベント処理で頻繁に使われます。","domain":"programming","keywords":["関数","非同期","イベント"]}]},
  {"term":"anonymous function","reading":"あのにますふぁんくしょん","aliases":["無名関数"],"senses":[{"definition":"名前を持たずにその場で定義する関数です。コールバックや即時実行関数として使われます。","domain":"programming","keywords":["関数","ラムダ","コールバック"]}]},
  {"term":"module","aliases":[],"senses":[{"definition":"機能ごとに分割されたコードのまとまりです。importやexportで他のファイルと連携します。","domain":"programming","keywords":["import","export","分割"]}]},
  {"term":"dependency","reading":"でぃぺんでんしー","aliases":[],"senses":[{"definition":"あるコードやモジュールが動作するために必要とする外部のライブラリやパッケージのことです。","domain":"programming","keywords":["ライブラリ","パッケージ","npm"]}]},
  {"term":"instance","reading":"いんすたんす","aliases":[],"senses":[{"definition":"クラスという設計図から実際に生成された具体的なオブジェクトです。new演算子などで作成します。","domain":"programming","keywords":["クラス","オブジェクト","new"]}]},
  {"term":"constructor","reading":"こんすとらくた","aliases":["コンストラクタ"],"senses":[{"definition":"クラスからインスタンスを生成するときに最初に呼び出される特別なメソッドです。初期化処理を記述します。","domain":"programming","keywords":["クラス","初期化","new"]}]},
  {"term":"public","reading":"ぱぶりっく","aliases":[],"senses":[{"definition":"クラスの外部からアクセスできることを示すアクセス修飾子です。","domain":"programming","keywords":["アクセス修飾子","可視性","クラス"]}]},
  {"term":"private","reading":"ぷらいべーと","aliases":[],"senses":[{"definition":"クラスの内部からのみアクセスできることを示すアクセス修飾子です。外部から直接操作できません。","domain":"programming","keywords":["アクセス修飾子","カプセル化","クラス"]}]},
  {"term":"protected","reading":"ぷろてくてっど","aliases":[],"senses":[{"definition":"同じクラスとその子クラスからアクセスできることを示すアクセス修飾子です。","domain":"programming","keywords":["アクセス修飾子","継承","クラス"]}]},
  {"term":"static","reading":"すたてぃっく","aliases":["静的"],"senses":[{"definition":"インスタンスではなくクラス自体に属するメンバーを示すキーワードです。インスタンスを作らずに使えます。","domain":"programming","keywords":["クラス","メンバー","インスタンス"]}]},
  {"term":"override","reading":"おーばーらいど","aliases":["オーバーライド"],"senses":[{"definition":"親クラスで定義されたメソッドを子クラスで上書きして、異なる振る舞いを実装することです。","domain":"programming","keywords":["継承","メソッド","ポリモーフィズム"]}]},
  {"term":"composition","reading":"こんぽじしょん","aliases":["合成","コンポジション"],"senses":[{"definition":"継承ではなく、オブジェクトを部品として組み合わせて機能を構成する設計手法です。「has-a」の関係を表します。","domain":"programming","keywords":["設計","オブジェクト指向","部品"]}]},
  {"term":"association","reading":"あそしえーしょん","aliases":["関連"],"senses":[{"definition":"オブジェクト同士が何らかの関係を持つことを表すオブジェクト指向の概念です。","domain":"programming","keywords":["オブジェクト指向","関係","モデリング"]}]},
  {"term":"tuple","reading":"たぷる","aliases":["タプル"],"senses":[{"definition":"複数の値を順序付きでまとめた、原則として変更不可のデータ構造です。Pythonなどで使われます。","domain":"programming","keywords":["データ構造","配列","不変"]}]},
  {"term":"binary tree","reading":"ばいなりーつりー","aliases":["二分木"],"senses":[{"definition":"各ノードが最大2つの子ノードを持つ木構造です。探索や整列の基礎として重要です。","domain":"programming","keywords":["データ構造","木構造","探索"]}]},
  {"term":"hash table","reading":"はっしゅてーぶる","aliases":["ハッシュテーブル"],"senses":[{"definition":"キーをハッシュ関数で変換し、対応する値へ高速にアクセスできるデータ構造です。平均O(1)で検索できます。","domain":"programming","keywords":["データ構造","キー","高速検索"]}]},
  {"term":"heap","reading":"ひーぷ","aliases":["ヒープ"],"senses":[{"definition":"最大値または最小値を効率よく取り出せる木構造のデータ構造です。優先度付きキューの実装に使われます。","domain":"programming","keywords":["データ構造","優先度","木構造"]}]},
