# The eighth TSV column is an optional annotation. An empty value is encoded
# by the schema-required final tab, so it is data rather than trailing padding.
data/it-terms.tsv whitespace=-blank-at-eol
data/conversion-priorities.tsv whitespace=-blank-at-eol

# These directories contain manifest-bound JSON/JSONL artifacts. Keep their
# bytes stable across Windows checkouts because manifests store SHA-256 values.
/data/llm-detail-targets/** text eol=lf
/data/llm-details/** text eol=lf
/corpus/** text eol=lf

# The release reranker is a content-addressed runtime artifact. Never apply
# newline or encoding conversion to its ONNX bytes.
/models/**/*.onnx binary
